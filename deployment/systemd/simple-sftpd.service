[Unit]
Description=Simple Secure FTP Daemon
Documentation=https://github.com/SimpleDaemons/simple-sftpd
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=simple-sftpd
Group=simple-sftpd
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/simple-sftpd --config /etc/simple-sftpd/simple-sftpd.conf --foreground
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=simple-sftpd

StateDirectory=simple-sftpd
LogsDirectory=simple-sftpd
ConfigurationDirectory=simple-sftpd
ReadWritePaths=/var/ftp

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
