#!/bin/sh
set -e

SERVICE=simple-sftpd
SERVICE_USER=simple-sftpd
SERVICE_GROUP=simple-sftpd

case "$1" in
    configure)
        if ! getent passwd "$SERVICE_USER" >/dev/null 2>&1; then
            if command -v adduser >/dev/null 2>&1; then
                adduser --system --group --home /var/lib/simple-sftpd \
                    --no-create-home --disabled-login --disabled-password \
                    --gecos "Simple Secure FTP Daemon" "$SERVICE_USER" 2>/dev/null || \
                useradd --system --home-dir /var/lib/simple-sftpd --shell /usr/sbin/nologin \
                    --comment "Simple Secure FTP Daemon" "$SERVICE_USER"
            else
                useradd --system --home-dir /var/lib/simple-sftpd --shell /sbin/nologin \
                    --comment "Simple Secure FTP Daemon" "$SERVICE_USER"
            fi
        fi

        mkdir -p /var/ftp /var/log/simple-sftpd /var/lib/simple-sftpd
        chown "$SERVICE_USER:$SERVICE_GROUP" /var/ftp /var/log/simple-sftpd /var/lib/simple-sftpd
        chmod 755 /etc/simple-sftpd

        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper unmask "${SERVICE}.service" || true
            deb-systemd-helper preset "${SERVICE}.service" || true
            deb-systemd-helper enable "${SERVICE}.service" || true
            deb-systemd-helper try-restart "${SERVICE}.service" || true
        elif command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload
            systemctl enable "${SERVICE}.service" || true
            systemctl try-restart "${SERVICE}.service" || true
        fi
        ;;
esac

exit 0
